# Environment values override the corresponding YAML values.
# Supported chains: 1 (Ethereum mainnet) or 8453 (Base). RPC endpoints must match CHAIN_ID.
CHAIN_ID=8453
RPC_URL=https://base-rpc.example
# Required by commands whose active targetRate strategy is variable_rate_avg.
REFERENCE_RPC_URL=https://base-archive-rpc.example
# Exactly one write-mode signer source is required. The method is derived for legacy
# MAKER_PRIVATE_KEY-only deployments, but setting it explicitly is recommended.
MAKER_PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
KEY_STORAGE_METHOD=private-key
# Keystore alternative (leave blank while KEY_STORAGE_METHOD=private-key):
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEYSTORE_INTERACTIVE=false
# AWS KMS alternative (direct remote signing; signer must differ from MAKER_ADDRESS):
AWS_KMS_KEY_ID=
AWS_REGION=
# Required in both write and read-only modes.
MAKER_ADDRESS=0x1111111111111111111111111111111111111111
MIDNIGHT_ADDRESS=0x2222222222222222222222222222222222222222
LOAN_ASSET_ADDRESS=0x3333333333333333333333333333333333333333
RATIFIER_ADDRESS=0x4444444444444444444444444444444444444444
MARKET_IDS=0x5555555555555555555555555555555555555555555555555555555555555555
# Required by commands whose active targetRate strategy is variable_rate_avg.
REFERENCE_MARKET_ID=0x7777777777777777777777777777777777777777777777777777777777777777
NATIVE_RESERVE_WEI=10000000000000000
# Required only for AWS write mode.
SIGNER_NATIVE_RESERVE_WEI=
# Required in write mode. Positive decimal numbers of gwei, not necessarily whole.
# Calibrate the tip per chain: Base tips are nominal (~0.005), mainnet's are a real market (~1-2).
MAX_FEE_GWEI=100
PRIORITY_FEE_GWEI=0.01
MAX_TRANSACTION_SPEND_WEI=100000000000000000
MAX_PUBLICATION_GAS=5000000
MAX_PUBLICATION_DATA_BYTES=65536
MAX_CANCELLATION_GAS=100000
MAX_BATCH_CANCELLATION_GAS=1000000
MAX_BATCH_CANCELLATION_DATA_BYTES=65536
# Required only for local or keystore Setter mode.
MAX_RATIFICATION_GAS=
MORPHO_API_BASE_URL=https://api.example
V0_OFFER_GROUP_IDS=0x8888888888888888888888888888888888888888888888888888888888888888
REQUEST_TIMEOUT_MS=10000
TRANSACTION_RECEIPT_TIMEOUT_MS=180000
# Optional structured log shipping. Set both values together; partial configuration emits a
# logship.misconfigured error and ships nothing.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
# Optional Better Stack heartbeat URL. Heartbeat failures never interrupt quoter-bot.
BETTERSTACK_HEARTBEAT_URL=
# BOOTSTRAP_MARKETS replaces the YAML list. Every integer property must be a quoted decimal string.
# The optional maturityPremium object adds min(floor(premiumPerYearBps * secondsToMaturity / 31536000),
# maximumPremiumBps) BPS to the quote; omit the object for the static premium only.
BOOTSTRAP_MARKETS=[{"marketId":"0x5555555555555555555555555555555555555555555555555555555555555555","targetRate":{"strategy":"variable_rate_avg"},"creditTarget":"10000000000","acceptanceAssets":"100000000","offerSize":"500000000","premiumBps":"-50","maturityPremium":{"shape":"linear","premiumPerYearBps":"120","maximumPremiumBps":"300"},"maximumMarketExposure":"20000000000","maximumTotalExposure":"30000000000","minimumRateBps":"200","maximumRateBps":"800","autoRefill":false}]
# LADDER_MARKETS replaces YAML ladder. Every integer-valued property must be a quoted decimal string.
# The optional maturityPremium object raises the ladder center by min(floor(premiumPerYearBps *
# secondsToMaturity / 31536000), maximumPremiumBps) BPS; omit the object for the static center only.
LADDER_MARKETS=[{"marketId":"0x5555555555555555555555555555555555555555555555555555555555555555","targetRate":{"strategy":"hardcoded","hardcodedRateBps":"400"},"quotePremiumBps":"0","maturityPremium":{"shape":"linear","premiumPerYearBps":"120","maximumPremiumBps":"300"},"spreadBps":"200","stepBps":"100","rungCount":"3","sizeSkewBps":"0","lowerRateBudgetAssets":"10000000000","higherRateBudgetAssets":"10000000000","targetMarketExposureAssets":"20000000000","maximumTotalExposureAssets":"30000000000","minimumOfferAssets":"101000000","groupMode":"shared-rung","loopIntervalSeconds":"60","movementToleranceBps":"10","minimumRateBps":"200","maximumRateBps":"800"}]
